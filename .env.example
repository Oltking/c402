# c402 - environment template. Copy to .env and fill secrets. NEVER commit .env.
# Network: Ethereum Sepolia (chainId 11155111 / CAIP-2 eip155:11155111)

# ---- Secrets (fill in .env; leave blank here) ----
SEPOLIA_RPC_URL=               # your Alchemy/Infura HTTPS Sepolia endpoint
SEPOLIA_PRIVATE_KEY=           # server operator key (0x...). On a PUBLIC endpoint use a THROWAWAY faucet wallet only. NEVER commit, NEVER put on Vercel.

# ---- Public-endpoint guardrails (optional; used when hosting for anyone to test) ----
# CDE_PAY_TO=                  # address that receives USDC payment (defaults to the operator address)
# RATE_LIMIT_PER_MIN=3         # per-IP paid-call limit (0 = off)
# DAILY_CALL_CAP=200           # global paid-calls/day cap (0 = off)
# MIN_GAS_WEI=2000000000000000 # below this operator ETH balance, /v1/decide returns a graceful 503 (0 = off)

# ---- Verified on-chain addresses (public; from docs/verified-addresses.md) ----
NOX_COMPUTE_ADDRESS=0x24ef36ec5b626d7dcd09a98f3083c2758f0f77bf
