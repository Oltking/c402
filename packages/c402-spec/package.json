{
  "name": "@c402/spec",
  "version": "0.1.0",
  "description": "c402 - confidential compute layer on top of x402. Shared protocol constants, header codecs, and types.",
  "license": "MIT",
  "author": "Oltking",
  "homepage": "https://use-c402.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oltking/c402.git",
    "directory": "packages/c402-spec"
  },
  "keywords": ["c402", "x402", "confidential-compute", "tee", "iexec", "attestation", "ethereum"],
  "type": "module",
  "main": "src/index.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.11.0",
    "tsup": "^8.3.5",
    "typescript": "~5.8.0"
  }
}
