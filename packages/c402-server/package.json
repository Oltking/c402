{
  "name": "@c402/server",
  "version": "0.1.0",
  "description": "Declare a confidential, pay-per-call compute endpoint in one function. x402 payment + Nox TEE execution + attestation, handled for you.",
  "license": "MIT",
  "author": "Oltking",
  "homepage": "https://use-c402.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oltking/c402.git",
    "directory": "packages/c402-server"
  },
  "keywords": ["c402", "x402", "confidential-compute", "tee", "iexec", "attestation", "express", "ethereum"],
  "type": "module",
  "main": "src/index.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@c402/spec": "workspace:*",
    "@x402/core": "2.19.0",
    "@x402/evm": "2.19.0",
    "@x402/express": "2.19.0",
    "viem": "^2.46.3"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.11.0",
    "express": "^4.22.2",
    "tsup": "^8.3.5",
    "typescript": "~5.8.0"
  }
}
